{
  "name": "progetto-ingegneria-del-software",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "npm run docker:db:up && cd backend && npm run dev",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "npm run docker:db:up && cd backend && npm run start",
    "build": "concurrently \"npm run build:frontend\" \"npm run build:backend\"",
    "build:frontend": "cd frontend && npm run build-only",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "format": "prettier --write ./**/*ts",
    "docker:db:up": "docker compose -f backend/connections/PostgreSQL/compose.yaml up -d",
    "docker:db:down": "docker compose -f backend/connections/PostgreSQL/compose.yaml down",
    "docker:db:logs": "docker compose -f backend/connections/PostgreSQL/compose.yaml logs -f",
    "docker:build": "node scripts/docker-publish.js --build-only",
    "docker:push": "node scripts/docker-publish.js",
    "docker:deploy": "node scripts/docker-publish.js"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/supertest": "^6.0.3",
    "chai": "^5.2.0",
    "@types/node": "^22.15.30",
    "concurrently": "^8.2.2",
    "mocha": "^11.5.0",
    "prettier": "3.5.3",
    "supertest": "^7.1.1"
  },
  "dependencies": {}
}
