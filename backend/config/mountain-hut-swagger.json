  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login and retrieve the user profile",
        "description": "Verifies the Firebase ID Token, retrieves the user from PostgreSQL and assigns the user's role as a Firebase custom claim.",
        "operationId": "loginUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "message": "Login successful",
                  "user": {
                    "id": "uuid",
                    "name": "John",
                    "surname": "Smith",
                    "email": "john@example.com",
                    "mobileNumber": "123456789",
                    "notes": null,
                    "emergencyContact": null,
                    "role": "HIKER"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header missing or invalid"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "description": "Verifies the Firebase ID Token and creates a new user record in PostgreSQL. The default role assigned to new users is HIKER.",
        "operationId": "registerUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "surname", "email", "mobile_number"],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John"
                  },
                  "surname": {
                    "type": "string",
                    "example": "Smith"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@example.com"
                  },
                  "mobile_number": {
                    "type": "string",
                    "example": "123456789"
                  },
                  "notes": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "emergency_contact": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Missing required fields"
          },
          "401": {
            "description": "Authorization header missing or invalid"
          },
          "409": {
            "description": "A user with this Firebase UID or email address already exists."
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/tables": {
      "post": {
        "tags": ["Tables"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-roles": ["EMPLOYEE", "WARDEN"],
        "summary": "Create a table",
        "operationId": "createTable",
        "responses": {
          "201": {
            "description": "Table created successfully"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authorization header missing or invalid"
          },
          "403": {
            "description": "Forbidden: User does not have the required role"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTableRequest"
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Tables"],
        "summary": "Get all tables",
        "description": "Lists dining tables ordered by table number. Supports optional active-state and available-capacity filters. Returns an empty array if no tables match.",
        "operationId": "getTables",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-roles": ["EMPLOYEE", "WARDEN"],
        "parameters": [
          {
            "name": "active",
            "in": "query",
            "required": false,
            "description": "Filter by active state: true selects active tables, false selects inactive tables. Omit to include both.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "available",
            "in": "query",
            "required": false,
            "description": "When true, include only tables with occupancy below capacity. False or omission applies no availability filter.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dining tables matching the filters, ordered by table number.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters: active and available must be true or false when provided."
          },
          "401": {
            "description": "Authorization header missing or invalid."
          },
          "403": {
            "description": "Forbidden: user does not have the required role."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
