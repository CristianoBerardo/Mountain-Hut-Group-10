        "summary": "Create a reservation",
        "operationId": "createReservation",
        "responses": {
          "201": {
            "description": "Reservation created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationMutationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, invalid dietary information, duplicate confirmed booking, insufficient seats, or less than two hours before the meal."
          },
          "401": {
            "description": "Authorization header missing or invalid"
          },
          "403": {
            "description": "Forbidden: user does not have the required role."
          },
          "404": {
            "description": "Selected meal slot not found."
          },
          "409": {
            "description": "The reservation conflicts with an existing or related record."
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReservationRequest"
              },
              "examples": {
                "withoutDietaryRequirements": {
                  "summary": "Reservation without dietary requirements",
                  "value": {
                    "hiker_id": "f2693a0f-0a2c-4402-a771-481f4a1f4ea8",
                    "meal_slot_id": "aaaaaaaa-0001-0001-0001-000000000001",
                    "party_size": 3
                  }
                },
                "withDietaryRequirements": {
                  "summary": "Three people in two allergen groups and one shared preference textbox",
                  "value": {
                    "hiker_id": "f2693a0f-0a2c-4402-a771-481f4a1f4ea8",
                    "meal_slot_id": "aaaaaaaa-0001-0001-0001-000000000001",
                    "party_size": 3,
                    "allergens": [
                      {
                        "people_count": 2,
                        "allergens": ["MILK", "SULPHITES"]
                      },
                      {
                        "people_count": 1,
                        "allergens": ["LUPIN", "MILK"]
                      }
                    ],
                    "preferences": "One vegetarian; avoid spicy food."
                  }
                }
              }
            }
          }
        },
        "description": "Creates a confirmed reservation and assigns tables. Reservations must be made at least two hours before the meal starts. Allergens and preferences are optional and are saved together with the reservation."
      }
    },
