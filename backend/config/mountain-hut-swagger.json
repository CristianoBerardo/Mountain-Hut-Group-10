  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login and retrieve the user profile",
        "description": "Verifies the Firebase ID Token, retrieves the user from PostgreSQL and assigns the user's role as a Firebase custom claim.",
        "operationId": "loginUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "message": "Login successful",
                  "user": {
                    "id": "uuid",
                    "name": "John",
                    "surname": "Smith",
                    "email": "john@example.com",
                    "mobileNumber": "123456789",
                    "notes": null,
                    "emergencyContact": null,
                    "role": "HIKER"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authorization header missing or invalid"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "description": "Verifies the Firebase ID Token and creates a new user record in PostgreSQL. The default role assigned to new users is HIKER.",
        "operationId": "registerUser",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "surname",
                  "email",
                  "mobile_number"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John"
                  },
                  "surname": {
                    "type": "string",
                    "example": "Smith"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@example.com"
                  },
                  "mobile_number": {
                    "type": "string",
                    "example": "123456789"
                  },
                  "notes": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "emergency_contact": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Missing required fields"
          },
          "401": {
            "description": "Authorization header missing or invalid"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
