    "/api/v1/users/{firebase_uid}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a user by Firebase UID",
        "description": "Retrieve a single user using their Firebase Authentication UID (not the PostgreSQL UUID). The response contains the fields of the corresponding Hiker, Employee or Warden DTO. Enter an existing Firebase UID to try a successful request, or an unknown UID to test the 404 response. This route currently has no authentication middleware.",
        "operationId": "getUserByFirebaseUid",
        "security": [],
        "parameters": [
          {
