  "components": {
    "schemas": {
      "Table": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "table_number": {
            "type": "integer",
            "example": 10
          },
          "capacity": {
            "type": "integer",
            "example": 6
          },
          "occupancy": {
            "type": "integer",
            "example": 0
          },
          "is_active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "CreateTableRequest": {
        "type": "object",
        "required": ["table_number", "capacity", "occupancy", "is_active"],
        "properties": {
          "table_number": {
            "type": "integer",
            "example": 10
          },
          "capacity": {
            "type": "integer",
            "example": 6
          },
          "occupancy": {
            "type": "integer",
            "example": 0
          },
          "is_active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "UpdateTableRequest": {
        "type": "object",
        "properties": {
          "table_number": {
            "type": "integer",
            "example": 3
          },
          "capacity": {
            "type": "integer",
            "example": 8
          },
          "occupancy": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "Allergen": {
        "type": "string",
        "description": "Supported allergen category code.",
        "enum": [
          "GLUTEN_CEREALS",
          "CRUSTACEANS",
          "EGGS",
          "FISH",
          "PEANUTS",
          "SOYBEANS",
          "MILK",
          "TREE_NUTS",
          "CELERY",
          "MUSTARD",
          "SESAME",
          "SULPHITES",
          "LUPIN",
          "MOLLUSCS"
        ],
        "example": "MILK"
      },
      "ReservationAllergenGroup": {
        "type": "object",
        "required": ["people_count", "allergens"],
        "description": "A group of people sharing the same combination of allergens.",
        "properties": {
          "people_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of people with this complete combination of allergens.",
            "example": 2
          },
          "allergens": {
            "type": "array",
            "minItems": 1,
            "description": "Allergens for this group. Repeated codes are removed and the codes are sorted before saving.",
            "items": {
              "$ref": "#/components/schemas/Allergen"
            },
            "example": ["MILK", "SULPHITES"]
          }
        }
      },
      "Reservation": {
        "type": "object",
        "required": [
          "id",
          "hiker_id",
          "meal_slot_id",
          "starts_at",
          "ends_at",
          "party_size",
          "status",
          "allergens",
          "preferences",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "bbbbbbbb-0001-0001-0001-000000000001"
          },
          "hiker_id": {
            "type": "string",
            "format": "uuid",
            "example": "f2693a0f-0a2c-4402-a771-481f4a1f4ea8"
          },
          "meal_slot_id": {
            "type": "string",
            "format": "uuid",
            "example": "aaaaaaaa-0001-0001-0001-000000000001"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Start time derived from the meal slot.",
            "example": "2026-11-29T12:00:00Z"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "description": "End time derived from the meal slot.",
            "example": "2026-11-29T13:30:00Z"
          },
          "party_size": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          },
          "status": {
            "type": "string",
            "enum": ["CONFIRMED", "CANCELLED", "COMPLETED", "NO_SHOW"],
            "example": "CONFIRMED"
          },
          "allergens": {
            "type": "array",
            "description": "Each row represents people sharing the same complete combination of allergens. Count each person in one group only. The sum of people_count must not exceed party_size. Duplicate combinations are rejected after sorting and removing repeated allergens within each row. An empty array means no allergen groups have been recorded.",
            "items": {
              "$ref": "#/components/schemas/ReservationAllergenGroup"
            },
            "example": [
              {
                "people_count": 2,
                "allergens": ["MILK", "SULPHITES"]
              },
              {
                "people_count": 1,
                "allergens": ["LUPIN", "MILK"]
              }
            ]
          },
          "preferences": {
            "type": "string",
            "nullable": true,
            "description": "Free-text dietary preferences for the entire reservation. Null when no preference has been recorded; an empty string is also possible.",
            "example": "One vegetarian; avoid spicy food."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-25T09:00:00Z"
          }
        }
      },
      "ReservationTableAssignment": {
        "type": "object",
        "required": ["dining_table_id", "table_number", "seats_assigned"],
        "properties": {
          "dining_table_id": {
            "type": "string",
            "format": "uuid",
            "example": "dddddddd-0001-0001-0001-000000000001"
          },
          "table_number": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          },
          "seats_assigned": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          }
        }
      },
      "ReservationDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Reservation"
          },
          {
            "type": "object",
            "required": ["tables"],
            "properties": {
              "tables": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReservationTableAssignment"
                }
              }
            }
          }
        ]
      },
      "ReservationMutationResponse": {
        "type": "object",
        "required": ["reservation", "tables"],
        "properties": {
          "reservation": {
            "$ref": "#/components/schemas/Reservation"
          },
          "tables": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationTableAssignment"
            }
          }
        }
      },
      "CreateReservationRequest": {
        "type": "object",
        "required": ["hiker_id", "meal_slot_id", "party_size"],
        "properties": {
          "hiker_id": {
            "type": "string",
            "format": "uuid",
            "example": "f2693a0f-0a2c-4402-a771-481f4a1f4ea8"
          },
          "meal_slot_id": {
            "type": "string",
            "format": "uuid",
            "example": "aaaaaaaa-0001-0001-0001-000000000001"
          },
          "party_size": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          },
          "allergens": {
            "type": "array",
            "description": "Each row represents people sharing the same complete combination of allergens. Count each person in one group only. The sum of people_count must not exceed party_size. Duplicate combinations are rejected after sorting and removing repeated allergens within each row. Optional. If omitted or empty, no allergen groups are saved. Null is rejected.",
            "items": {
              "$ref": "#/components/schemas/ReservationAllergenGroup"
            },
            "default": [],
            "example": [
              {
                "people_count": 2,
                "allergens": ["MILK", "SULPHITES"]
              },
              {
                "people_count": 1,
                "allergens": ["LUPIN", "MILK"]
              }
            ]
          },
          "preferences": {
            "type": "string",
            "description": "Optional free-text preferences for the entire reservation. If omitted, NULL is stored. An empty string is accepted; null in the request is rejected.",
            "example": "One vegetarian; avoid spicy food."
          }
        }
      },
      "UpdateReservationRequest": {
        "type": "object",
        "required": ["party_size"],
        "properties": {
          "party_size": {
            "type": "integer",
            "minimum": 1,
            "example": 3,
            "description": "Required even when only dietary information changes. If allergens is omitted, the existing group total must still fit this party size."
          },
          "allergens": {
            "type": "array",
            "description": "Each row represents people sharing the same complete combination of allergens. Count each person in one group only. The sum of people_count must not exceed party_size. Duplicate combinations are rejected after sorting and removing repeated allergens within each row. If omitted, existing groups are preserved. An empty array removes all groups. A non-empty array replaces all groups. Null is rejected.",
            "items": {
              "$ref": "#/components/schemas/ReservationAllergenGroup"
            },
            "example": [
              {
                "people_count": 2,
                "allergens": ["MILK", "SULPHITES"]
              },
              {
                "people_count": 1,
                "allergens": ["LUPIN", "MILK"]
              }
            ]
          },
          "preferences": {
            "type": "string",
            "description": "Free-text preferences for the entire reservation. If omitted, the existing text is preserved. Send an empty string to clear it. Null is rejected.",
            "example": "One vegetarian; avoid spicy food."
          }
        }
      },
      "CreateSlotRequest": {
        "type": "object",
        "required": ["date", "starts_at", "ends_at"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-11-05"
          },
          "starts_at": {
            "type": "string",
            "example": "17:00"
          },
          "ends_at": {
            "type": "string",
            "example": "18:00"
          }
        }
      },
      "AddTableToSlotRequest": {
        "type": "object",
        "required": ["dining_table_id"],
        "properties": {
          "dining_table_id": {
            "type": "string",
            "format": "uuid",
            "example": "1757cdf9-a0d6-4723-9bea-4a7ebff31a7c"
          }
        }
      }
    },
    "parameters": {
      "tableId": {
        "name": "tableId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "reservationId": {
        "name": "reservationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "slotId": {
        "name": "slotId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "tableNumber": {
        "name": "tableNumber",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 1
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Insert the Firebase Token"
      }
    }
  }
}
