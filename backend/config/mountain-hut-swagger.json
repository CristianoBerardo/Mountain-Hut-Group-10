          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateReservationRequest"
              },
              "examples": {
                "preserveDietaryRequirements": {
                  "summary": "Change party size and preserve dietary requirements",
                  "value": {
                    "party_size": 4
                  }
                },
                "replaceDietaryRequirements": {
                  "summary": "Replace allergen groups and preferences",
                  "value": {
                    "party_size": 3,
                    "allergens": [
                      {
                        "people_count": 2,
                        "allergens": ["MILK", "SULPHITES"]
                      },
                      {
                        "people_count": 1,
                        "allergens": ["LUPIN", "MILK"]
                      }
                    ],
                    "preferences": "One vegetarian; avoid spicy food."
                  }
                },
                "clearDietaryRequirements": {
                  "summary": "Remove all groups and clear preferences",
                  "value": {
                    "party_size": 3,
                    "allergens": [],
                    "preferences": ""
                  }
                }
              }
            }
          }
        },
        "description": "Updates a confirmed reservation at least two hours before the meal. party_size is required. Omitted allergens or preferences preserve their existing values. An empty allergens array removes all groups; an empty preferences string clears the text."
      },
